# Copy to .env (chmod 600) and fill in MODEL_API_KEY. Never commit .env.
# MODEL_MODE: openai = require the key (refuses to start without it)
#             auto   = use the key if set, otherwise the labelled scripted offline mode
#             offline = never call a model
MODEL_MODE=openai
MODEL_API_KEY=
# OPENAI_API_KEY is also accepted. MODEL_API_KEY_FILE can point to a mounted secret file.
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=https://api.openai.com/v1
# Model-call ceiling per conversation (a turn uses about 2-5 calls). Beyond it, replies
# come from the scripted assistant with a visible note; New session resets it.
MODEL_MAX_CALLS_PER_CONVERSATION=300

# Leave blank for today's date. Historical demo dates do not change security TTLs.
DEMO_AS_OF_DATE=
# Use true behind HTTPS. Keep false for plain HTTP.
COOKIE_SECURE=false
# DATA_DIR defaults to ./data; Docker sets /data.

# Human handling requests and email enquiries are asynchronous simulations.
# There is no real insurer mailbox or live staff connection.
