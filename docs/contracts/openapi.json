  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffUpdate": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Session Id"
          },
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Message Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "action": {
            "type": "string",
            "enum": [
              "note",
              "cancel",
              "demo_acknowledge",
              "demo_reply",
              "demo_close"
            ],
            "title": "Action"
          },
          "text": {
            "type": "string",
            "maxLength": 1000,
            "title": "Text",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "message_id",
          "expected_revision",
          "action"
        ],
        "title": "HandoffUpdate"
      },
      "InquiryCreate": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Message Id"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30,
                "pattern": "^CL-\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "subject": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "subject",
          "body"
        ],
        "title": "InquiryCreate"
      },
      "InquiryUpdate": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Message Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "action": {
            "type": "string",
            "enum": [
              "followup",
              "demo_reply",
              "close",
              "cancel"
            ],
            "title": "Action"
          },
          "text": {
            "type": "string",
            "maxLength": 1000,
            "title": "Text",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "expected_revision",
          "action"
        ],
        "title": "InquiryUpdate"
      },
      "LookupForm": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name",
            "default": ""
          },
          "dob": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^(?:\\d{4}-\\d{2}-\\d{2})?$",
            "title": "Dob",
            "default": ""
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "title": "Phone",
            "default": ""
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "title": "Email",
            "default": ""
          },
          "ssn_last4": {
            "type": "string",
            "maxLength": 4,
            "pattern": "^(?:\\d{4})?$",
            "title": "Ssn Last4",
            "default": ""
          },
          "national_id_last4": {
            "type": "string",
            "maxLength": 4,
            "pattern": "^(?:\\d{4})?$",
            "title": "National Id Last4",
            "default": ""
          },
          "policy_number": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^(?:POL-\\d+)?$",
            "title": "Policy Number",
            "default": ""
          },
          "case_id": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^(?:CL-\\d+)?$",
            "title": "Case Id",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LookupForm"
      },
      "TurnRequest": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Message Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "title": "Text",
            "default": ""
          },
          "action": {
            "type": "string",
            "enum": [
              "message",
              "finish",
              "email_send",
              "email_skip",
              "email_cancel",
              "human",
              "reset",
              "cancel",
              "resume",
              "wait_human",
              "confirm_claim",
              "handoff_note_accept",
              "handoff_note_decline",
              "consent_check",
              "consent_timeout",
              "interrupt",
              "form",
              "my_claims",
              "handoff_status",
              "inquiry_status",
              "email_edit",
              "email_prepare"
            ],
            "title": "Action",
            "default": "message"
          },
          "offer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Offer Id"
          },
          "form": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LookupForm"
              },
              {
                "type": "null"
              }
            ]
          },
          "email_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Note"
          },
          "target_message_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Message Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "expected_version"
        ],
        "title": "TurnRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
