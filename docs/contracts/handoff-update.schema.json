{
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "maxLength": 100,
      "title": "Session Id",
      "type": "string"
    },
    "message_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Message Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "action": {
      "enum": [
        "note",
        "cancel",
        "demo_acknowledge",
        "demo_reply",
        "demo_close"
      ],
      "title": "Action",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 1000,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "message_id",
    "expected_revision",
    "action"
  ],
  "title": "HandoffUpdate",
  "type": "object"
}
